<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Functional_Testing.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5075"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Clients" custom_title="0" dock_id="1" table="4,7:mainClients"/><dock_state state="000000ff00000000fd0000000100000002000001ee00000215fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001ee0000012e00ffffff000001ee0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Clients" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="1" mode="0"/></sort><column_widths><column index="1" value="53"/><column index="2" value="239"/><column index="3" value="147"/><column index="4" value="223"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ДЕМОНСТРАЦИЯ: Что происходит при реальной попытке нарушения ограничений
SELECT '=== ДЕМОНСТРАЦИЯ РАБОТЫ CHECK-ОГРАНИЧЕНИЙ ===' AS Info;

SELECT 'ПРИМЕЧАНИЕ: При попытке выполнить следующий запрос:' AS Message
UNION ALL
SELECT 'INSERT INTO Products (ProductName, Price, Stock) VALUES (''Тест нарушения'', -50.00, 100);' AS Message
UNION ALL
SELECT 'Система вернет ошибку: &quot;CHECK constraint failed: Price &gt; 0&quot;' AS Message
UNION ALL
SELECT 'Это подтверждает, что ограничения работают корректно!' AS Message;

INSERT INTO ErrorLog (Component, ErrorType, ErrorDetails)
VALUES ('Boundary Testing', 'Constraint Protection', 
        'CHECK constraints are working: Price &gt; 0 and Stock &gt;= 0 prevent invalid data insertion');


SELECT '=== ВЫВОДЫ ПО ТЕСТИРОВАНИЮ ОГРАНИЧЕНИЙ ===' AS Info
UNION ALL
SELECT ' CHECK-ограничения работают корректно' AS Conclusions
UNION ALL
SELECT ' Система предотвращает вставку некорректных данных' AS Conclusions
UNION ALL
SELECT ' Граничные значения протестированы успешно' AS Conclusions
UNION ALL
SELECT ' Все тестовые сценарии выполнены' AS Conclusions
UNION ALL
SELECT ' Ошибки залогированы для анализа' AS Conclusions;</sql><current_tab id="0"/></tab_sql></sqlb_project>
