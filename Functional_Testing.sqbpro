<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/wam2d/OneDrive/Desktop/тех 2025/МДК 2.2/Лабораторные работы/лаба 15 (10) Отчёт мдк 2.2 Боткин Артём ИС 23.1/Functional_Testing.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="5075"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Clients" custom_title="0" dock_id="1" table="4,7:mainClients"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000012e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- Создание комплексного отчета по всем тестам интеграции
CREATE VIEW Integration_Testing_Final_Report AS
SELECT 
    'Тестирование передачи данных между формами' AS TestCategory,
    COUNT(*) AS TotalTests,
    SUM(CASE WHEN TestResult = 'PASS' THEN 1 ELSE 0 END) AS PassedTests,
    SUM(CASE WHEN TestResult = 'FAIL' THEN 1 ELSE 0 END) AS FailedTests
FROM FormIntegrationTests

UNION ALL

SELECT 
    'Автоматическая проверка целостности',
    COUNT(*),
    SUM(CASE WHEN CheckResult = 'PASS' THEN 1 ELSE 0 END),
    SUM(CASE WHEN CheckResult = 'FAIL' THEN 1 ELSE 0 END)
FROM AutoIntegrityCheck

UNION ALL

SELECT 
    'Проверка связей между таблицами',
    COUNT(*),
    SUM(CASE WHEN TestStatus = 'PASS' THEN 1 ELSE 0 END),
    SUM(CASE WHEN TestStatus = 'FAIL' THEN 1 ELSE 0 END)
FROM IntegrationTests
WHERE TestType IN ('Foreign Key Validation', 'Data Integrity');


SELECT * FROM Integration_Testing_Final_Report;


SELECT 
    'ИТОГИ ИНТЕГРАЦИОННОГО ТЕСТИРОВАНИЯ' AS ReportTitle,
    SUM(TotalTests) AS 'Всего тестов',
    SUM(PassedTests) AS 'Успешных тестов',
    SUM(FailedTests) AS 'Проваленных тестов',
    ROUND(SUM(PassedTests) * 100.0 / SUM(TotalTests), 2) || '%' AS 'Общая успешность'
FROM Integration_Testing_Final_Report;</sql><current_tab id="0"/></tab_sql></sqlb_project>
